# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/virtual_lover

# 智谱AI开放平台配置（https://open.bigmodel.cn）
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPUAI_CHAT_API_KEY=your-chat-api-key
ZHIPUAI_CHAT_MODEL=glm-5.2
# 视觉模型（图片理解：图生文、图文聊天）
ZHIPUAI_VISION_MODEL=glm-4v-plus
ZHIPUAI_IMAGE_API_KEY=your-image-api-key

# 邮件 SMTP 配置（可选，如使用手机登录可不配置）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# 短信服务配置（阿里云短信）
SMS_ACCESS_KEY_ID=your-access-key-id
SMS_ACCESS_KEY_SECRET=your-access-key-secret
SMS_SIGN_NAME=虚拟恋人
SMS_TEMPLATE_CODE=SMS_1234567890

# 认证密钥（生成方式：openssl rand -base64 32）
AUTH_SECRET=your-secret-key-here

# 应用名称
APP_NAME=虚拟恋人